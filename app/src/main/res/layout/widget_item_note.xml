<?xml version="1.0" encoding="utf-8"?>
<!--
    widget_item_note.xml — A single row in the medium widget's recent notes list.

    This layout is inflated by WidgetNotesRemoteViewsFactory.getViewAt().
    The entire row (widget_note_row) has a fill-in intent set on it so tapping
    the row opens that specific note in MainActivity.

    DESIGN:
    - Title in white, monospace
    - Preview snippet in gray below
    - Subtle left border using a View to suggest a note card
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:gravity="center_vertical">

    <!-- Left accent bar -->
    <TextView
        android:layout_width="2dp"
        android:layout_height="32dp"
        android:background="#FF3A3A3A"
        android:layout_marginEnd="10dp"
        android:text="" />

    <!-- Text content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_note_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF888888"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>