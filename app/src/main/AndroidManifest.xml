<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to open the camera app for photo capture -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        VIBRATE — used by VoiceCaptureActivity to give haptic feedback
        when recording starts/stops. Declared here; actual vibration is optional.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".VoidNoteApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoidNote"
        tools:targetApi="31">

        <!-- ── Main Activity ───────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VoidNote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── FileProvider ────────────────────────────────────────────────── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ══════════════════════════════════════════════════════════════════
             SPRINT 16: QUICK CAPTURE WIDGET
             ══════════════════════════════════════════════════════════════════

             HOW ANDROID WIDGETS WORK IN THE MANIFEST:
             Each widget requires a <receiver> that:
               1. Handles the APPWIDGET_UPDATE broadcast
               2. Declares the android:permission for security
               3. Points to the AppWidgetProviderInfo XML via <meta-data>
        ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ── 1×1 Quick Note Widget ──────────────────────────────────────── -->
        <receiver
            android:name=".widget.VoidNoteWidgetNewNote"
            android:exported="true"
            android:label="Void Note — Quick Note">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_new_note_info" />
        </receiver>

        <!-- ── 1×1 Voice Record Widget ────────────────────────────────────── -->
        <receiver
            android:name=".widget.VoidNoteWidgetRecord"
            android:exported="true"
            android:label="Void Note — Record">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info" />
        </receiver>

        <!-- ── Widget Provider: Medium (4×2) ──────────────────────────────── -->
        <receiver
            android:name=".widget.VoidNoteWidgetMedium"
            android:exported="true"
            android:label="Void Note (Medium)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium_info" />
        </receiver>

        <!-- ── Quick Capture Activity ──────────────────────────────────────── -->
        <!--
            Transparent dialog theme: the user sees the launcher behind this Activity,
            creating the "typing on the home screen" effect. You may need to add
            Theme.VoidNote.Transparent to your styles.xml (see notes below).
        -->
        <activity
            android:name=".widget.QuickCaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.VoidNote.Transparent"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- ── Voice Capture Activity ──────────────────────────────────────── -->
        <activity
            android:name=".widget.VoiceCaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.VoidNote.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- ── Widget Settings Activity ────────────────────────────────────── -->
        <!--
            android:exported="true" is REQUIRED for configure activities.
            The launcher needs to be able to start this Activity when the user
            long-presses the widget and taps "Widget settings".
        -->
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.VoidNote" />

        <!-- ── Widget Notes RemoteViews Service ────────────────────────────── -->
        <!--
            android:permission="android.permission.BIND_REMOTEVIEWS" is REQUIRED.
            This prevents other apps from binding to our RemoteViewsService
            and reading the widget's data (which would be a privacy issue since
            notes are encrypted — but defence in depth is good practice).
        -->
        <service
            android:name=".widget.WidgetNotesRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>